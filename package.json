{
  "name": "thirdrailify-v2-admin",
  "private": true,
  "version": "0.1.0-alpha.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:functions": "node --test --test-concurrency=1 tests/auth-migration.test.mjs tests/auth-functions.test.mjs tests/profile-media.test.mjs tests/commerce-migration.test.mjs tests/permanent-catalogue-import.test.mjs tests/commerce-core.test.mjs tests/commerce-functions.test.mjs tests/product-merchandising.test.mjs tests/printful.test.mjs tests/printful-catalogue.test.mjs tests/printful-permanent-migration.test.mjs tests/catalogue-reconciliation.test.mjs tests/live-wix-census.test.mjs tests/checkout.test.mjs tests/controlled-test-checkout.test.mjs tests/stripe-webhook.test.mjs tests/stripe-acceptance-closure.test.mjs tests/goats-migration.test.mjs tests/goats-core.test.mjs tests/watch-admin.test.mjs tests/banner-admin.test.mjs",
    "test:watch": "node --test --test-concurrency=1 tests/watch-admin.test.mjs",
    "test:banner": "node --test --test-concurrency=1 tests/banner-admin.test.mjs",
    "test:printful": "node --test --test-concurrency=1 tests/printful.test.mjs tests/printful-catalogue.test.mjs",
    "test:browser:fulfillment": "node --test --test-concurrency=1 tests/fulfillment-browser.test.mjs",
    "test:browser:goats": "node --test --test-concurrency=1 tests/goats-browser.test.mjs",
    "test:browser:watch": "node --test --test-concurrency=1 tests/watch-browser.test.mjs",
    "test:browser:banner": "node --test --test-concurrency=1 tests/banner-browser.test.mjs",
    "test:browser:orders": "node --test --test-concurrency=1 tests/orders-browser.test.mjs",
    "test:browser:commerce": "node --test --test-concurrency=1 tests/commerce-browser.test.mjs",
    "test:admin-ui": "node --test tests/admin-ui.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "commerce:migration:build": "node scripts/build-commerce-migration-artifacts.mjs",
    "commerce:catalogue:validate": "node scripts/validate-permanent-catalogue.mjs",
    "commerce:catalogue:build-import": "node scripts/build-permanent-catalogue-import.mjs",
    "commerce:printful:verify-permanent": "node scripts/verify-permanent-printful-token.mjs",
    "goats:import:dry-run": "node scripts/validate-goats-import.mjs",
    "goats:wix:build-import": "node scripts/build-wix-goats-import.mjs",
    "test:goats:wix-import": "node --test --test-concurrency=1 tests/wix-goats-import.test.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.14.0",
    "playwright-core": "1.55.0",
    "sharp": "0.35.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.19",
    "wrangler": "4.60.0"
  }
}
