export type CustomShape = { interpolation: "monotone-pchip"; points: CustomShapePoint[] };
export type WheelMechanics = { mechanicsVersion: 2; curveProfile: WheelCurveProfile; physics: WheelPhysics; customShape: CustomShape; launchRpsMin: number; launchRpsMax: number; minimumFullTurns: number; maximumFullTurns: number; defaultSpinDurationMs: number; minimumSpinDurationMs: number; maximumSpinDurationMs: number };
