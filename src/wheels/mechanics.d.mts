export type NaturalnessDiagnostics = { speedAt25: number; speedAt50: number; speedAt75: number; speedAt90: number; tailDurationFraction: number; terminalSpeed: number; terminalAcceleration: number; peakDeceleration: number; maximumJerk: number; estimatedFinalClickIntervalMs: number; finalTravelPercent: number; captureSpeedRemoved: number; handbrakeRisk: boolean; checks: { monotoneSpeed: boolean; softTerminalStop: boolean; noReverseMotion: boolean; noFinalSnap: boolean; suspenseTailPresent: boolean; frameRateIndependent: boolean } };
